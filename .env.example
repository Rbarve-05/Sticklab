# Copy this file to .env and add your Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Story writing model
GEMINI_MODEL=gemini-3.5-flash-lite

# Generate cinematic 9:16 illustrated stills for each scene.
# Image generation may incur separate API charges.
STICKLAB_IMAGE_GENERATION_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Deep cinematic narration (Gemini TTS; may incur API charges).
GEMINI_TTS_ENABLED=false
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_STYLE=Deep cinematic storyteller. Low warm resonant voice, intimate suspense, controlled natural pacing, deliberate pauses before reveals, clear English diction.

# Local story generator server
STICKLAB_PORT=4179
